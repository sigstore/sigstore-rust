"""Type stubs for the exception hierarchy defined in the native extension.

These cannot be auto-generated by pyo3-stub-gen (pyo3::create_exception!).
"""

class SigstoreError(Exception):
    """Base exception for all py-sigstore errors."""
    ...

class VerificationError(SigstoreError):
    """Raised when artifact or bundle verification fails."""
    ...

class SigningError(SigstoreError):
    """Raised when artifact signing fails."""
    ...

class BundleError(SigstoreError):
    """Raised when a Sigstore bundle cannot be parsed or is structurally invalid."""
    ...

class TrustedRootError(SigstoreError):
    """Raised when a TrustedRoot cannot be loaded, fetched, or parsed."""
    ...

class IdentityTokenError(SigstoreError):
    """Raised when an OIDC identity token is invalid, expired, or cannot be detected."""
    ...

class IdentityMismatchError(VerificationError):
    """Raised when the signer identity or OIDC issuer does not match the policy."""
    ...

class SignatureInvalidError(VerificationError):
    """Raised when a signature does not verify."""
    ...

class ArtifactMismatchError(VerificationError):
    """Raised when the bundle does not describe the supplied artifact."""
    ...

class CertificateError(VerificationError):
    """Raised when the signing certificate, its chain or its SCT is invalid."""
    ...

class TransparencyLogError(VerificationError):
    """Raised when transparency log evidence is invalid."""
    ...

class TimestampError(VerificationError):
    """Raised when an RFC 3161 timestamp is invalid or missing."""
    ...

class UnsupportedAlgorithmError(VerificationError):
    """Raised when a key or signature algorithm is not supported."""
    ...

class SigningConfigError(SigningError):
    """Raised when the signing configuration is invalid or cannot be satisfied."""
    ...

class RekorError(SigningError):
    """Raised when Rekor rejects or fails a request."""
    status: int | None
    """HTTP status returned by the service, if the failure was an HTTP status."""

class FulcioError(SigningError):
    """Raised when Fulcio rejects or fails a request."""
    status: int | None
    """HTTP status returned by the service, if the failure was an HTTP status."""

class TsaError(SigningError):
    """Raised when the timestamp authority request fails."""
    ...

class TufError(TrustedRootError):
    """Raised when fetching or validating trust material through TUF fails."""
    ...
